{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"trailingComma": "all",
	"sortImports": {
		"groups": [
			"side_effect",
			"builtin",
			"external",
			["internal", "subpath"],
			["parent", "sibling", "index"],
			"style",
			"unknown"
		]
	},
	"sortPackageJson": true,
	"ignorePatterns": [".cursor/**", ".agents/**", "bun.lock"]
}
