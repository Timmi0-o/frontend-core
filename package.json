{
	"name": "@timmi0-o/frontend-core",
	"version": "0.0.1",
	"description": "Shared frontend primitives: UI kits, hooks, abstract actions, utils",
	"type": "module",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timmi0-o/frontend-core.git"
	},
	"exports": {
		"./ui-kit": {
			"types": "./dist/kits/ui-kit/index.d.ts",
			"import": "./dist/kits/ui-kit/index.js",
			"default": "./dist/kits/ui-kit/index.js"
		},
		"./social-ui-kit": {
			"types": "./dist/kits/social/index.d.ts",
			"import": "./dist/kits/social/index.js",
			"default": "./dist/kits/social/index.js"
		},
		"./admin-ui-kit": {
			"types": "./dist/kits/admin/index.d.ts",
			"import": "./dist/kits/admin/index.js",
			"default": "./dist/kits/admin/index.js"
		},
		"./social-ui-kit/styles.css": {
			"default": "./dist/kits/social/styles.css"
		},
		"./admin-ui-kit/styles.css": {
			"default": "./dist/kits/admin/styles.css"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"import": "./dist/hooks/index.js",
			"default": "./dist/hooks/index.js"
		},
		"./actions": {
			"types": "./dist/actions/index.d.ts",
			"import": "./dist/actions/index.js",
			"default": "./dist/actions/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js",
			"default": "./dist/utils/index.js"
		}
	},
	"scripts": {
		"build": "vite build",
		"playground": "vite --config playground/vite.config.ts",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"@base-ui/react": "^1.7.0",
		"framer-motion": ">=11",
		"next": ">=14",
		"react": "^19",
		"react-dom": "^19",
		"sonner": "^2.0.8",
		"swiper": "^14",
		"vaul": "^1",
		"zod": "^4"
	},
	"peerDependenciesMeta": {
		"swiper": {
			"optional": true
		},
		"vaul": {
			"optional": true
		},
		"framer-motion": {
			"optional": true
		},
		"next": {
			"optional": true
		}
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@base-ui/react": "^1.7.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.0.0",
		"framer-motion": "^13.1.1",
		"next": "^16.2.6",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"swiper": "^14.0.5",
		"typescript": "^5",
		"vaul": "^1.1.2",
		"vite": "^7.0.0",
		"vite-plugin-dts": "^4.5.0",
		"zod": "^4.4.3"
	}
}
